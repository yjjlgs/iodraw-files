mp;quot;Microsoft YaHei&amp;quot;, sans-serif; color: rgb(191, 191, 191); text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;2. 程序运行流程&lt;/h3&gt;&lt;h3 style=&quot;line-height: normal; font-size: 13px; margin: 1.5em 0px 0.875em; font-family: &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, sans-serif; color: rgb(191, 191, 191); text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;&lt;ul style=&quot;padding-inline-start: 24px; font-weight: 400;&quot;&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;启动流程图&lt;ul style=&quot;padding-inline-start: 24px;&quot;&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;&lt;code style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 10.998px; color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 1px 3px; border-radius: 4px; border-color: rgb(140, 140, 140); border-style: none; border-width: 3px; border-image: none 100% / 1 / 0 stretch; white-space: pre-wrap;&quot;&gt;reset&lt;/code&gt; -&amp;gt; &lt;code style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 10.998px; color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 1px 3px; border-radius: 4px; border-color: rgb(140, 140, 140); border-style: none; border-width: 3px; border-image: none 100% / 1 / 0 stretch; white-space: pre-wrap;&quot;&gt;main()&lt;/code&gt; -&amp;gt; 向量表/中断组态 -&amp;gt; &lt;code style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 10.998px; color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 1px 3px; border-radius: 4px; border-color: rgb(140, 140, 140); border-style: none; border-width: 3px; border-image: none 100% / 1 / 0 stretch; white-space: pre-wrap;&quot;&gt;start_task&lt;/code&gt;&lt;/li&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;&lt;code style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 10.998px; color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 1px 3px; border-radius: 4px; border-color: rgb(140, 140, 140); border-style: none; border-width: 3px; border-image: none 100% / 1 / 0 stretch; white-space: pre-wrap;&quot;&gt;start_task&lt;/code&gt; 初始化顺序 -&amp;gt; 创建各业务任务 -&amp;gt; 自删除&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;业务主流程图&lt;ul style=&quot;padding-inline-start: 24px;&quot;&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;&lt;code style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 10.998px; color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 1px 3px; border-radius: 4px; border-color: rgb(140, 140, 140); border-style: none; border-width: 3px; border-image: none 100% / 1 / 0 stretch; white-space: pre-wrap;&quot;&gt;MainCycle_task&lt;/code&gt; 周期检查&lt;/li&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;&lt;code style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 10.998px; color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 1px 3px; border-radius: 4px; border-color: rgb(140, 140, 140); border-style: none; border-width: 3px; border-image: none 100% / 1 / 0 stretch; white-space: pre-wrap;&quot;&gt;PeltCtrl_task&lt;/code&gt; PID 控制循环&lt;/li&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;&lt;code style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 10.998px; color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 1px 3px; border-radius: 4px; border-color: rgb(140, 140, 140); border-style: none; border-width: 3px; border-image: none 100% / 1 / 0 stretch; white-space: pre-wrap;&quot;&gt;task_inadc_moniter&lt;/code&gt; ADC 采集与报警&lt;/li&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;&lt;code style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 10.998px; color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 1px 3px; border-radius: 4px; border-color: rgb(140, 140, 140); border-style: none; border-width: 3px; border-image: none 100% / 1 / 0 stretch; white-space: pre-wrap;&quot;&gt;Ads1247_task&lt;/code&gt; DRDY 中断驱动采集&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;事件流&lt;ul style=&quot;padding-inline-start: 24px;&quot;&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;外部中断 / DMA / CAN / ETH / USART 触发链路&lt;/li&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;任务唤醒与信号量关系&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/h3&gt;&lt;h3 style=&quot;line-height: normal; font-size: 13px; margin: 1.5em 0px 0.875em; font-family: &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, sans-serif; color: rgb(191, 191, 191); text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;3. 数据流与状态流&lt;/h3&gt;&lt;h3 style=&quot;line-height: normal; font-size: 13px; margin: 1.5em 0px 0.875em; font-family: &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, sans-serif; color: rgb(191, 191, 191); text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;&lt;ul style=&quot;padding-inline-start: 24px; font-weight: 400;&quot;&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;关键全局数据结构&lt;ul style=&quot;padding-inline-start: 24px;&quot;&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;参数区（如 &lt;code style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 10.998px; color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 1px 3px; border-radius: 4px; border-color: rgb(140, 140, 140); border-style: none; border-width: 3px; border-image: none 100% / 1 / 0 stretch; white-space: pre-wrap;&quot;&gt;stParamFram&lt;/code&gt;、&lt;code style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 10.998px; color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 1px 3px; border-radius: 4px; border-color: rgb(140, 140, 140); border-style: none; border-width: 3px; border-image: none 100% / 1 / 0 stretch; white-space: pre-wrap;&quot;&gt;g_WndAbnormalInfo&lt;/code&gt;）&lt;/li&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;运行状态变量（如温度、故障标志、CAN/网络状态）&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;主要数据路径&lt;ul style=&quot;padding-inline-start: 24px;&quot;&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;采集 -&amp;gt; 处理 -&amp;gt; 控制 -&amp;gt; 报警/显示/上传&lt;/li&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;命令接收 -&amp;gt; 解析 -&amp;gt; 响应&lt;/li&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;ADS1247 / ADC1 / CAN / LAN / UART 数据走向&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;配置/参数持久化&lt;ul style=&quot;padding-inline-start: 24px;&quot;&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;FRAM 参数读写流程&lt;/li&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;BOOT 标志与升级状态&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/h3&gt;&lt;h3 style=&quot;line-height: normal; font-size: 13px; margin: 1.5em 0px 0.875em; font-family: &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, sans-serif; color: rgb(191, 191, 191); text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;4. 硬件映射与接口关系&lt;/h3&gt;&lt;h3 style=&quot;line-height: normal; font-size: 13px; margin: 1.5em 0px 0.875em; font-family: &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, sans-serif; color: rgb(191, 191, 191); text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;&lt;ul style=&quot;padding-inline-start: 24px; font-weight: 400;&quot;&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;重要外设和引脚映射&lt;ul style=&quot;padding-inline-start: 24px;&quot;&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;ADS1247 SPI/DRDY/RESET&lt;/li&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;DRV8432 PWM/FAULT/RESET&lt;/li&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;LAN RMII 和 PHY&lt;/li&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;CAN1 RX/TX&lt;/li&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;风扇故障/门磁/过温等检测输入&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;软硬件版本差异&lt;ul style=&quot;padding-inline-start: 24px;&quot;&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;&lt;code style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 10.998px; color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 1px 3px; border-radius: 4px; border-color: rgb(140, 140, 140); border-style: none; border-width: 3px; border-image: none 100% / 1 / 0 stretch; white-space: pre-wrap;&quot;&gt;BOARD_V4&lt;/code&gt; / &lt;code style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 10.998px; color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 1px 3px; border-radius: 4px; border-color: rgb(140, 140, 140); border-style: none; border-width: 3px; border-image: none 100% / 1 / 0 stretch; white-space: pre-wrap;&quot;&gt;BOARD_V6&lt;/code&gt;、不同传感器类型、不同引脚配置&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/h3&gt;&lt;h3 style=&quot;line-height: normal; font-size: 13px; margin: 1.5em 0px 0.875em; font-family: &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, sans-serif; color: rgb(191, 191, 191); text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;5. 错误处理与异常机制&lt;/h3&gt;&lt;h3 style=&quot;line-height: normal; font-size: 13px; margin: 1.5em 0px 0.875em; font-family: &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, sans-serif; color: rgb(191, 191, 191); text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;&lt;ul style=&quot;padding-inline-start: 24px; font-weight: 400;&quot;&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;故障检测与屏蔽逻辑&lt;ul style=&quot;padding-inline-start: 24px;&quot;&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;&lt;code style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 10.998px; color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 1px 3px; border-radius: 4px; border-color: rgb(140, 140, 140); border-style: none; border-width: 3px; border-image: none 100% / 1 / 0 stretch; white-space: pre-wrap;&quot;&gt;Gen_AbnormalShieldPro()&lt;/code&gt; / &lt;code style=&quot;font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 10.998px; color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 1px 3px; border-radius: 4px; border-color: rgb(140, 140, 140); border-style: none; border-width: 3px; border-image: none 100% / 1 / 0 stretch; white-space: pre-wrap;&quot;&gt;Gen_AbnormalShieldCtrl()&lt;/code&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;关键故障路径&lt;ul style=&quot;padding-inline-start: 24px;&quot;&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;漏液、过温、风扇故障、PT100异常&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;保护动作&lt;ul style=&quot;padding-inline-start: 24px;&quot;&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;关断 PWM&lt;/li&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;关闭风扇&lt;/li&gt;&lt;li style=&quot;margin: 4px 0px;&quot;&gt;报警输出&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/h3&gt;&lt;h3 style=&quot;line-height: normal; font-size: 13px; margin: 1.5em 0px 0.875em; font-family: &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, sans-serif; color: rgb(191, 191, 191); text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;6. 通信协议与外部接口&lt;/h3&gt;&lt;h3 style=&quot;line-height: normal; font-size: 13px; margin: 1.5em 0px 0.875em; font-family: &amp;quot;Segoe WPC&amp;quot;, &amp;quot;Segoe UI&amp;quot;, &amp;quot;Microsoft YaHei&amp;quot;, sans-serif; color: rgb(191, 191, 191); text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;&lt;ul style=&quo