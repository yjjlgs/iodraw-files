          <mxGeometry x="1935" y="5319" width="100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="HHBuEm-rtrzqzi3aGq35-398" value="&lt;div style=&quot;font-size:25px;font-weight:700;color:#203047;line-height:1.25&quot;&gt;是：或其他错误退出路径到 ret&lt;/div&gt;&lt;div style=&quot;font-size:21px;color:#203047;line-height:1.28&quot;&gt;设置 fVoltageStandby；Debug 输出状态；return eValveStatus&lt;/div&gt;" style="shape=rounded;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;strokeColor=#36845A;fillColor=#FFFFFF;strokeWidth=3;rounded=1;arcSize=18;" vertex="1" parent="1">
