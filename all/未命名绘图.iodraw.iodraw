        <mxCell id="HHBuEm-rtrzqzi3aGq35-401" value="&lt;div style=&quot;font-size:19px;color:#45566E;white-space:nowrap&quot;&gt;goto retry&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=2;strokeColor=none;fillColor=#F8FAFC;rounded=1;arcSize=8;strokeOpacity=0;" vertex="1" parent="1">
