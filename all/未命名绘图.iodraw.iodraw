          <mxGeometry x="1395" y="5416" width="100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="HHBuEm-rtrzqzi3aGq35-400" value="&lt;div style=&quot;font-size:25px;font-weight:700;color:#203047;line-height:1.25&quot;&gt;返回 eValveStatus 给上层命令处理&lt;/div&gt;&lt;div style=&quot;font-size:21px;color:#203047;line-height:1.28&quot;&gt;上层再组织 max3485_response()（串口调用关系沿用历史梳理）&lt;/div&gt;" style="shape=rounded;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;strokeColor=#5285B5;fillColor=#FFFFFF;strokeWidth=3;rounded=1;arcSize=18;" vertex="1" parent="1">
